import telebot
import random

bot = telebot.TeleBot("8050795924:AAGDMDK2U4-w6KvIXEMdwpZRt5ABVxtILcc")

memes = {
    "common": {
        "chance": 60,
        "file": "images/mem1.jpg"
    },
    "epic": {
        "chance": 25,
        "file": "images/mem2.jpg"
    },
    "legendary": {
